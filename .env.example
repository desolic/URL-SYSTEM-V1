# Address the service binds to. Behind a reverse proxy, keep this on localhost.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Public domain used to build short links: https://<SHORT_DOMAIN>/<slug>
SHORT_DOMAIN=link.desolic.com

# Fallback redirect for unknown slugs. Must be an https:// URL.
DEFAULT_REDIRECT=https://desolic.com/

# SHA-256 hex digest of the API token. Generate a token + hash with:
#   npm run gen-token
AUTH_TOKEN_HASH=

# Path to the SQLite database file.
DATABASE_PATH=./data/db.sqlite

# Set to false if the service is NOT behind a trusted reverse proxy.
TRUST_PROXY=true
