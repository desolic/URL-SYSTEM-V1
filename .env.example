# Address the service binds to. Behind a reverse proxy, keep this on localhost.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Public domain used to build short links: https://<SHORT_DOMAIN>/<slug>
SHORT_DOMAIN=link.desolic.com

# Fallback redirect for unknown slugs. Must be an https:// URL.
DEFAULT_REDIRECT=https://desolic.com/

# SHA-256 hex digest of the API token. Generate a token + hash with:
#   npm run gen-token
# In the docker-compose deployment this value is read by compose and mounted
# into the url-shortener container as the file /run/secrets/auth_token_hash
# (so it does NOT appear in `docker inspect`).
AUTH_TOKEN_HASH=

# Alternative for the bare-Node deployment: point to a file that contains the
# hash instead of inlining it above. Leave unset when using AUTH_TOKEN_HASH.
# AUTH_TOKEN_HASH_FILE=/run/secrets/auth_token_hash

# Path to the SQLite database file.
DATABASE_PATH=./data/db.sqlite

# Set to false if the service is NOT behind a trusted reverse proxy.
TRUST_PROXY=true

# Only for the docker-compose deployment: the Cloudflare Tunnel token from the
# Cloudflare Zero Trust dashboard. Used by the cloudflared container.
CF_TUNNEL_TOKEN=
